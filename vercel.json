{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/home.html", "destination": "/" },
    { "source": "/admin.html", "destination": "/?admin=true" },
    { "source": "/driver.html", "destination": "/?view=driver" },
    { "source": "/driver", "destination": "/?view=driver" },
    { "source": "/registration.html", "destination": "/?view=registration" },
    { "source": "/registration", "destination": "/?view=registration" },
    { "source": "/register.html", "destination": "/?view=registration" },
    { "source": "/register", "destination": "/?view=registration" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
